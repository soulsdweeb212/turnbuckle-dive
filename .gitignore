# Game data: never commit ROMs or anything extracted or generated from them
*.z64
*.n64
*.v64
*.rom
*.o2r
*.otr
generated/

# Build output
build*/
cmake-build-*/
*.o
*.a
*.so
*.exe
*.dll

# Saves and local settings written by the program
saves/
*.sav
*.mpk
*.eep
*.sra
*.cfg.json
imgui.ini
logs/

# Editors and local tool settings (the shared VS Code launch and extension files are kept)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.vs/
out/
CMakeUserPresets.json
.idea/
.claude/settings.local.json
.DS_Store
