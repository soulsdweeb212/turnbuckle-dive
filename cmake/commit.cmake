# Writes OUT, a header that defines TD_COMMIT: the commit the program is built from, as git's short id (src/main.c
# prints it, and the splash screen shows it). The build runs this script
# each time (CMakeLists.txt, td_commit); it rewrites the header only when the text changes, so an unchanged commit
# rebuilds nothing. Without git, or outside a git checkout, TD_COMMIT is "unknown".
execute_process(COMMAND ${GIT} rev-parse --short=7 HEAD WORKING_DIRECTORY ${SOURCE} OUTPUT_VARIABLE commit
                RESULT_VARIABLE result OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT result EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
endif()
set(text "/* Generated by cmake/commit.cmake: the commit the program is built from. */\n#define TD_COMMIT \"${commit}\"\n")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
