+// Stores a new other_mode_h. The RDP applies the palette type (TEXTLUT) as it draws, so when a display list changes the
+// type, the CI textures in use were decoded with the old one. Marking the textures as changed makes the next triangle
+// import them again, and ImportTexture then finds or decodes them for the new type.
+static void SetOtherModeH(RDP* rdp, uint32_t other_mode_h) {
+    if (((rdp->other_mode_h ^ other_mode_h) & (3U << G_MDSFT_TEXTLUT)) != 0) {
+        rdp->textures_changed[0] = true;
+        rdp->textures_changed[1] = true;
+    }
+    rdp->other_mode_h = other_mode_h;
+}
+
 void Interpreter::GfxSpSetOtherMode(uint32_t shift, uint32_t num_bits, uint64_t mode) {
     uint64_t mask = (((uint64_t)1 << num_bits) - 1) << shift;
     uint64_t om = mRdp->other_mode_l | ((uint64_t)mRdp->other_mode_h << 32);
     om = (om & ~mask) | mode;
     mRdp->other_mode_l = (uint32_t)om;
-    mRdp->other_mode_h = (uint32_t)(om >> 32);
+    SetOtherModeH(mRdp, (uint32_t)(om >> 32));
 }
 
