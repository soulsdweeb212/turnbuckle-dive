+// The palette type. The N64's RDP reads it from other_mode_h's TEXTLUT field (gDPSetTextureLUT) each time it samples a
+// CI4 or CI8 texel, not when the palette is loaded, so one palette can be read either way. A G_TT_IA16 entry holds an
+// intensity and an alpha, a G_TT_RGBA16 entry an RGBA5551 colour; Fast3D also reads RGBA5551 for G_TT_NONE, as before.
+static bool PaletteIsIa16(uint32_t other_mode_h) {
+    return (other_mode_h & (3U << G_MDSFT_TEXTLUT)) == G_TT_IA16;
+}
+
+// Writes one palette entry (16 bits, high byte first as on the N64) into rgba as 8-bit red, green, blue and alpha. An
+// IA16 entry has the intensity in its high byte, which becomes the red, green and blue alike, and the alpha in its low
+// byte.
+static void DecodePaletteEntry(const uint8_t* entry, bool ia16, uint8_t* rgba) {
+    if (ia16) {
+        rgba[0] = entry[0];
+        rgba[1] = entry[0];
+        rgba[2] = entry[0];
+        rgba[3] = entry[1];
+        return;
+    }
+    uint16_t col16 = (entry[0] << 8) | entry[1];
+    rgba[0] = SCALE_5_8(col16 >> 11);
+    rgba[1] = SCALE_5_8((col16 >> 6) & 0x1f);
+    rgba[2] = SCALE_5_8((col16 >> 1) & 0x1f);
+    rgba[3] = (col16 & 1) ? 255 : 0;
+}
