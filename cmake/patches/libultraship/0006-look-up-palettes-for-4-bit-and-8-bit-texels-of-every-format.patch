+++ b/src/fast/interpreter.cpp
@@ -1295,6 +1295,14 @@ void Interpreter::ImportTexture(int i, int tile, bool importReplacement) {
                   ->second.replacementData
             : mRdp->loaded_texture[tmemIdex].addr;
 
+    // While palettes are on (other_mode_h's TEXTLUT field is G_TT_RGBA16 or G_TT_IA16), the RDP reads a 4-bit or 8-bit
+    // texel of any format as an index into the palette, so a tile tagged IA or I is then a CI texture: it is decoded
+    // through the palette, and its cache entry is a CI one, keyed by the palette too.
+    if (fmt != G_IM_FMT_CI && (siz == G_IM_SIZ_4b || siz == G_IM_SIZ_8b) &&
+        (mRdp->other_mode_h & (3U << G_MDSFT_TEXTLUT)) != G_TT_NONE) {
+        fmt = G_IM_FMT_CI;
+    }
