+// A fingerprint of the bytes a texture is decoded from: its texels as the decoders read them (lines of
+// line_size_bytes, full_image_line_size_bytes apart, from the loaded address), and for a CI texture the palette entries
+// it uses, from Fast3D's copy of the palette that G_LOADTLUT made. The cache key holds only addresses, and a game can
+// change a texture or a palette where it is, or load another one at the same address after freeing the memory; with
+// the fingerprint in the cache entry, such a texture is decoded again instead of drawn as it was.
+static uint64_t FingerprintBytes(uint64_t h, const uint8_t* p, size_t n) {
+    while (n >= 8) {
+        uint64_t w;
+        memcpy(&w, p, 8);
+        h = (h ^ w) * 0x9E3779B97F4A7C15ULL;
+        h ^= h >> 32;
+        p += 8;
+        n -= 8;
+    }
+    while (n > 0) {
+        h = (h ^ *p++) * 0x100000001B3ULL;
+        n--;
+    }
+    return h;
+}
+
+uint64_t Interpreter::TextureContent(int tile, const uint8_t* addr, uint32_t tmemIndex, uint8_t fmt,
+                                     uint8_t siz) const {
+    const auto& loaded = mRdp->loaded_texture[tmemIndex];
+    uint32_t size = loaded.size_bytes;
+    uint32_t line = loaded.line_size_bytes;
+    uint32_t stride = loaded.full_image_line_size_bytes;
+    size_t span = size;
+    uint64_t h = 0xCBF29CE484222325ULL;
+
+    if (addr == nullptr || size == 0) {
+        return 0;
+    }
+    if (line != 0 && stride > line && size > line) {
+        span = (size_t)stride * (size / line - 1) + line;
+    }
+    h = FingerprintBytes(h, addr, span);
+    if (fmt == G_IM_FMT_CI) {
+        uint8_t pal = mRdp->texture_tile[tile].palette;
+        if (siz == G_IM_SIZ_4b) {
+            if (mRdp->palettes[pal / 8] != nullptr) {
+                h = FingerprintBytes(h, mRdp->palettes[pal / 8] + (pal % 8) * 16 * 2, 16 * 2);
+            }
+        } else {
+            for (int k = 0; k < 2; k++) {
+                if (mRdp->palettes[k] != nullptr) {
+                    h = FingerprintBytes(h, mRdp->palettes[k], 256);
+                }
+            }
+        }
+    }
+    return h | 1; // never 0, which stands for a texture that cannot change
+}
