+// The sides of the view volume that a vertex in clip coordinates lies outside. GfxSpTri1 skips a triangle whose three
+// vertices are all outside the same side.
+static uint8_t ClipRejectFlags(float x, float y, float z, float w) {
+    uint8_t clip_rej = 0;
+
+    if (x < -w) {
+        clip_rej |= 1; // CLIP_LEFT
+    }
+    if (x > w) {
+        clip_rej |= 2; // CLIP_RIGHT
+    }
+    if (y < -w) {
