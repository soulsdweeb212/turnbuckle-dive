+// G_MODIFYVTX (gSPModifyVertex) overwrites one field of a vertex that G_VTX has already loaded and transformed. The
+// N64 keeps such a vertex as clip coordinates (used only for clipping), screen x and y, screen depth, 1/w, a colour
+// and texture coordinates, and `where` names the field to replace. Fast3D keeps clip coordinates instead of screen
+// ones (x, y, z and w, x already adjusted for the aspect ratio) and leaves the division by w and the viewport to the
+// GPU. So a new screen position or depth is worked back, through the current viewport, into clip coordinates at the
+// vertex's own w. That keeps 1/w, as the N64 does, so perspective-correct texturing stays as it was. The
+// trivial-rejection flags are then worked out again: the N64 keeps the ones G_VTX set, but those are for its clip box,
+// usually larger than the screen (gSPClipRatio), while Fast3D's are for the screen itself, so keeping them would throw
+// away sprites the N64 draws. Fast3D clips at the viewport's edges, so a point placed outside the viewport is cut off
+// there; the N64 draws up to the scissor.
 void Interpreter::GfxSpModifyVertex(uint16_t vtx_idx, uint8_t where, uint32_t val) {
-    SUPPORT_CHECK(where == G_MWO_POINT_ST);
-
-    int16_t s = (int16_t)(val >> 16);
-    int16_t t = (int16_t)val;
+    if (vtx_idx >= MAX_VERTICES) {
+        SPDLOG_WARN("G_MODIFYVTX: vertex {} is outside the vertex buffer", vtx_idx);
+        return;
+    }
 
     LoadedVertex* v = &mRsp->loaded_vertices[vtx_idx];
-    v->u = s;
-    v->v = t;
+    const F3DVp_t* vp = &mRsp->viewport;
+
+    switch (where) {
+        case G_MWO_POINT_RGBA:
+            // The shade colour, 0xRRGGBBAA. It replaces the colour G_VTX worked out (lit, with G_LIGHTING) and the
+            // alpha, which holds the fog factor with G_FOG: the N64 keeps both in these four bytes.
+            v->color.r = (uint8_t)(val >> 24);
+            v->color.g = (uint8_t)(val >> 16);
+            v->color.b = (uint8_t)(val >> 8);
+            v->color.a = (uint8_t)val;
+            break;
+        case G_MWO_POINT_ST:
+            // Texture coordinates s (high half) and t (low half), signed with 5 fraction bits. They replace the ones
+            // G_VTX worked out, which already include G_TEXTURE's scale.
+            v->u = (int16_t)(val >> 16);
+            v->v = (int16_t)val;
+            break;
+        case G_MWO_POINT_XYSCREEN:
+            // Screen x (high half) and y (low half), signed with 2 fraction bits like the viewport's scale and
+            // translation. The N64 works them out from clip coordinates as vtrans + x/w * vscale and
+            // vtrans - y/w * vscale (screen y grows downwards, clip y upwards); this works backwards from them. Before
+            // any viewport is loaded there is nothing to work back through.
+            if (vp->vscale[0] != 0 && vp->vscale[1] != 0) {
+                float x = ((int16_t)(val >> 16) - vp->vtrans[0]) / (float)vp->vscale[0];
+                float y = (vp->vtrans[1] - (int16_t)val) / (float)vp->vscale[1];
+
+                v->x = AdjXForAspectRatio(x * v->w);
+                v->y = y * v->w;
+                v->clip_rej = ClipRejectFlags(v->x, v->y, v->z, v->w);
+            }
+            break;
+        case G_MWO_POINT_ZSCREEN:
+            // Screen depth, signed with 16 fraction bits, in the units of the viewport's z scale and translation: the
+            // N64 works it out as vtrans + z/w * vscale. With the usual viewport (G_MAXZ / 2 for both) 0 is the near
+            // plane and 0x3FE << 16 the far one. gbi.h's G_DEPTOZS makes the same number for gSPBranchLessZ, which
+            // compares it with this field. A depth beyond the near or far plane is moved onto that plane, because the
+            // GPU would clip it away where the N64 still draws it.
+            if (vp->vscale[2] != 0) {
+                float z = ((int32_t)val / 65536.0f - vp->vtrans[2]) / vp->vscale[2];
+
+                v->z = std::clamp(z, -1.0f, 1.0f) * v->w;
+                v->clip_rej = ClipRejectFlags(v->x, v->y, v->z, v->w);
+            }
+            break;
+        default:
+            SPDLOG_WARN("G_MODIFYVTX: offset 0x{:X} is not a vertex field", where);
+            break;
+    }
 }
 
