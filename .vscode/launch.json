{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Turnbuckle Dive",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:turnbuckleDivePath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Show wrestler records as one line (tools/gdb/wrestler.py)",
                    "text": "source ${workspaceFolder}/tools/gdb/wrestler.py",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Turnbuckle Dive: one resource",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:turnbuckleDivePath}",
            "args": [
                "--res",
                "${input:resourceId}"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Show wrestler records as one line (tools/gdb/wrestler.py)",
                    "text": "source ${workspaceFolder}/tools/gdb/wrestler.py",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Turnbuckle Dive: dev match",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:turnbuckleDivePath}",
            "args": [
                "--dev-match",
                "--no-watchdog"
            ],
            "cwd": "${input:turnbuckleDiveDirectory}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Show wrestler records as one line (tools/gdb/wrestler.py)",
                    "text": "source ${workspaceFolder}/tools/gdb/wrestler.py",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Turnbuckle Dive: dev match (asan preset)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:turnbuckleDivePath}",
            "args": [
                "--dev-match",
                "--no-watchdog"
            ],
            "cwd": "${input:turnbuckleDiveDirectory}",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0:abort_on_error=1:handle_segv=2:handle_sigfpe=2"
                },
                {
                    "name": "UBSAN_OPTIONS",
                    "value": "print_stacktrace=1:abort_on_error=1"
                }
            ],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Show wrestler records as one line (tools/gdb/wrestler.py)",
                    "text": "source ${workspaceFolder}/tools/gdb/wrestler.py",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug hello window",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:helloPath}",
            "args": [],
            "cwd": "${input:helloDirectory}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Show wrestler records as one line (tools/gdb/wrestler.py)",
                    "text": "source ${workspaceFolder}/tools/gdb/wrestler.py",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug asset viewer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:viewerPath}",
            "args": [],
            "cwd": "${input:viewerDirectory}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Show wrestler records as one line (tools/gdb/wrestler.py)",
                    "text": "source ${workspaceFolder}/tools/gdb/wrestler.py",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "turnbuckleDivePath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "turnbuckle-dive"
            }
        },
        {
            "id": "turnbuckleDiveDirectory",
            "type": "command",
            "command": "cmake.getLaunchTargetDirectory",
            "args": {
                "targetName": "turnbuckle-dive"
            }
        },
        {
            "id": "resourceId",
            "type": "promptString",
            "description": "Resource to load: 1 to 7657, or in hex 0x1 to 0x1DE9",
            "default": "0x3"
        },
        {
            "id": "helloPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "hello"
            }
        },
        {
            "id": "helloDirectory",
            "type": "command",
            "command": "cmake.getLaunchTargetDirectory",
            "args": {
                "targetName": "hello"
            }
        },
        {
            "id": "viewerPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "viewer"
            }
        },
        {
            "id": "viewerDirectory",
            "type": "command",
            "command": "cmake.getLaunchTargetDirectory",
            "args": {
                "targetName": "viewer"
            }
        }
    ]
}
