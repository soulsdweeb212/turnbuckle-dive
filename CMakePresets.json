{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Linux"
                    ]
                }
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "No optimisation, full debug information",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "Optimised, still debuggable",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug + AddressSanitizer",
            "description": "Stops at the first memory error with the exact line",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TD_SANITIZE": "ON"
            }
        },
        {
            "name": "order",
            "displayName": "Debug + byte-order check",
            "description": "Lists game code that reads bytes at another width than they were written (docs/TESTING.md)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TD_ORDER_CHECK": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "description": "Visual Studio's compiler (cl) for 64-bit Windows; run from the x64 Native Tools Command Prompt for VS 2022 or from Visual Studio",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "environment": {
                "VCPKG_ROOT": "${sourceDir}/build/_vcpkg"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "USE_AUTO_VCPKG": "ON",
                "CMAKE_VS_PLATFORM_NAME": "x64"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug",
            "description": "No optimisation, full debug information (LibUltraShip then logs to a console window of its own)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-relwithdebinfo",
            "displayName": "Windows RelWithDebInfo",
            "description": "Optimised, still debuggable; what CI builds on Windows",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "order",
            "configurePreset": "order"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-relwithdebinfo",
            "configurePreset": "windows-relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "order",
            "configurePreset": "order",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-relwithdebinfo",
            "configurePreset": "windows-relwithdebinfo",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
